{
  "advanced_features": {
    "memory": {
      "enabled": true,
      "description": "Memoria persistente del usuario (siempre activa)",
      "settings": {
        "db_path": "~/.config/sylix/memory.db",
        "max_conversations": 1000,
        "max_actions": 500,
        "cleanup_days": 7,
        "optimize_for_offline": true
      }
    },
    "activity_monitor": {
      "enabled": true,
      "description": "Monitor de actividad del sistema (opcional)",
      "settings": {
        "db_path": "~/.config/sylix/activity.db",
        "monitor_interval": 5,
        "log_directory": "~/.config/sylix/activity_logs",
        "max_history_days": 7,
        "track_applications": true,
        "track_windows": true,
        "track_system_metrics": true,
        "privacy_mode": false,
        "low_resource_mode": true
      }
    },
    "proactive_thinking": {
      "enabled": true,
      "description": "Pensamiento proactivo y sugerencias (opcional)",
      "settings": {
        "db_path": "~/.config/sylix/proactive.db",
        "thinking_interval": 30,
        "max_suggestions": 5,
        "rules_directory": "~/.config/sylix/proactive_rules",
        "learning_enabled": true,
        "confidence_threshold": 0.6,
        "auto_suggest": true,
        "offline_optimized": true
      }
    },
    "integration": {
      "enabled": true,
      "description": "Integración entre características",
      "settings": {
        "sync_interval": 30,
        "shared_context": true,
        "cross_feature_learning": true,
        "privacy_preserving": true,
        "offline_mode_optimized": true
      }
    }
  },
  "privacy": {
    "data_retention_days": 7,
    "auto_cleanup": true,
    "encrypt_sensitive_data": false,
    "anonymous_analytics": false
  },
  "performance": {
    "max_memory_mb": 100,
    "background_priority": "low",
    "auto_optimize": true,
    "cleanup_schedule": "daily",
    "local_mode_optimization": {
      "enabled": true,
      "ollama_threads": "auto",
      "tts_chunk_size": 100,
      "tool_call_timeout": 10,
      "keep_alive_minutes": 15,
      "response_cache": true
    }
  },
  "notifications": {
    "enable_notifications": true,
    "notification_level": "important",
    "sound_enabled": true,
    "desktop_notifications": true
  }
}