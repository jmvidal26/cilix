# ═══════════════════════════════════════════════════════════════════════════
#  Cilix v2.0 · Ejemplo de configuración por entorno
#  Copia este archivo a `.env` y ajusta los valores. NADA se envía a la nube.
#
#  Lanzamiento (run.sh):
#     ./run.sh            -> modo navegador (BAJO en RAM, sin Electron)  [default]
#     ./run.sh --app      -> Electron (overlay transparente siempre arriba)
#     ./run.sh --backend  -> solo el servidor Python
# ═══════════════════════════════════════════════════════════════════════════

# ── Servidor local ───────────────────────────────────────────────────────────
CILIX_HOST=127.0.0.1
CILIX_PORT=8765
CILIX_DEV=false

# ── Protección de recursos (límite estricto de 8 GB) ──────────────────────────
CILIX_RAM_LIMIT_GB=8.0
CILIX_RAM_WARNING=78
CILIX_RAM_CRITICAL=88
CILIX_RAM_EMERGENCY=93        # por encima se descarga también Ri (se recarga sola)

# ── Cerebro (Ollama local) ─────────────────────────────────────────────────
OLLAMA_URL=http://localhost:11434
CILIX_RI_MODEL=qwen2.5:1.5b            # Cerebro unico residente (<1.5 GB)
# Para ahorrar ~600 MB mas: CILIX_RI_MODEL=llama3.2:1b  (y: ollama pull llama3.2:1b)
CILIX_RE_MODEL=deepseek-coder:1.3b     # Re: solo se usa si activas el modo dual
# false = un unico cerebro (Re nunca se carga, ahorra ~1 GB). true = modo dual.
CILIX_DUAL_BRAIN=false
CILIX_RI_KEEP_ALIVE=2m                 # Ri permanece en RAM (corto = libera antes)
CILIX_RE_KEEP_ALIVE=20s                # Re se libera rápido tras su uso

# ── AHORRO DE RAM en Ollama (los valores bajos reducen consumo) ───────────────
CILIX_OLLAMA_NUM_CTX=768              # ventana de contexto (menor = menos KV cache)
CILIX_OLLAMA_NUM_BATCH=128
CILIX_RI_NUM_PREDICT=110               # tokens máx. de salida Ri
CILIX_RE_NUM_PREDICT=400               # tokens máx. de salida Re
CILIX_OLLAMA_USE_MMAP=true             # mapear modelo a disco en vez de a RAM
CILIX_OLLAMA_NUM_THREAD=2

# ── Motor de voz (offline) ────────────────────────────────────────────────────
CILIX_VOICE_ENABLED=true
CILIX_WHISPER_MODEL=tiny               # STT ligero
CILIX_WHISPER_LANG=es
# Backend TTS: 'kokoro' (voz FEMENINA natural, ~325 MB, carga diferida)
#             o 'piper' (ligero ~60 MB, algo más robótico).
CILIX_TTS_BACKEND=kokoro
# Voz Kokoro femenina en español. Otras: em_alex/em_santa (M). Requiere
# models/kokoro/kokoro-v1.0.onnx y models/kokoro/voices-v1.0.bin.
CILIX_KOKORO_VOICE=ef_dora
# Velocidad >1 = habla más rápida y sensación más aguda (1.0 = normal):
CILIX_KOKORO_SPEED=1.25
# Tono WSOLA extra (+semitonas, duración intacta): 0 = ef_dora natural, 1-2 = más femenina:
CILIX_KOKORO_PITCH=0
# Precarga la voz al arrancar para que la 1ª frase salga rápida (se pospone si la RAM está alta):
CILIX_VOICE_WARMUP=true
# Hilos ONNXRuntime de Kokoro (menos = menos RAM/CPU):
CILIX_ORT_THREADS=2
# Descarga Kokoro/Whisper de RAM tras N s sin usar voz (se recargan solos):
CILIX_VOICE_IDLE_RELEASE=300
# Respaldo Piper si Kokoro no está disponible:
# CILIX_PIPER_VOICE=models/piper/es_ES-davefx-medium.onnx

# ── Percepción del escritorio ─────────────────────────────────────────────────
CILIX_VISION_ENABLED=false             # OFF por defecto para ahorrar RAM

# ── Modo ONLINE (opcional): cerebro = servidor local de OpenCode ────────────
# false = 100% local con Ollama. true = usa la API local de OpenCode y cae a
# Ollama si no está disponible (sin APIs de pago ni proveedores externos).
CILIX_ONLINE=false
CILIX_ONLINE_FALLBACK=true
# URL del servicio; vacío = se descubre con `opencode service status`.
CILIX_OPENCODE_URL=
# Password del servicio; vacío = se lee de ~/.config/opencode/service.json.
CILIX_OPENCODE_PASSWORD=
CILIX_OPENCODE_SESSION=Cilix · voz
# Modelo de la sesión "proveedor/modelo"; vacío = el que tenga OpenCode.
CILIX_OPENCODE_MODEL=
CILIX_OPENCODE_TIMEOUT=120

# ── Personalidad proactiva (Ri habla sola en idle + ánimo persistente) ─────
CILIX_PROACTIVE=true                   # activa el pensamiento proactivo
CILIX_PROACTIVE_IDLE=90                # seg. sin interactuar antes de comentar
CILIX_PROACTIVE_MIN_GAP=240            # seg. mínimos entre frases espontáneas
CILIX_PROACTIVE_MAX_HOUR=6             # máx. comentarios proactivos por hora
CILIX_PROACTIVE_QUIET_START=23         # hora silencio desde (24h)
CILIX_PROACTIVE_QUIET_END=8            # hora silencio hasta (24h)
CILIX_PROACTIVE_VOICE=true             # el impulso también se dice en voz alta (TTS)

# ── E.D.I.T.H (Le'fil) ───────────────────────────────────────────────
CILIX_EDITH_DIR=/home/jesvid/partes/Le-fil   # repo con scripts/edith_bridge.py
CILIX_EDITH_TIMEOUT=180                     # segundos máx. por acción

# ── Curiosidad autónoma (busca temas random y aprende) ───────────────────
CILIX_CURIOSITY=true                 # busca un tema al azar cada tanto
CILIX_CURIOSITY_INTERVAL=1800        # segundos entre búsquedas (30 min)
CILIX_CURIOSITY_IDLE=600             # solo si llevas 10 min sin hablar
CILIX_CURIOSITY_ENGINE=auto          # auto | google | bing | wikipedia

# Google Custom Search (opcional): si rellenas clave + cx, la curiosidad usa
# la API oficial de Google; si no, cae a Google HTML → Bing → Wikipedia.
# CILIX_GOOGLE_API_KEY=
# CILIX_GOOGLE_CX=

# ── Compañía en silencio (habla sola si no interactúas) ──────────────────
CILIX_COMPANION=true                 # módulo de voz espontánea
CILIX_COMPANION_IDLE=300             # 5 min de silencio para el primer saludo
CILIX_COMPANION_REPEAT=900           # 15 min mínimo entre intervenciones
CILIX_COMPANION_MAX_HOUR=3           # máximo de intervenciones por hora
CILIX_COMPANION_QUIET_START=23       # hora de silencio (23:00)
CILIX_COMPANION_QUIET_END=8          # hasta las 08:00
CILIX_COMPANION_VOICE=true           # también lo dice en voz alta

# ── Programación delegada (Antigravity CLI / Qoder CLI) ──────────────────
# Cilix pasa la tarea a `agy -p` (Antigravity) o `qoder -p` (Qoder) en modo
# headless. El agente corre como subproceso: 0 RAM cuando está en reposo.
CILIX_CODER_ENABLED=true
CILIX_CODER_PROVIDER=auto            # auto | agy | qoder
# CILIX_CODER_BIN=                   # binario explícito (agy/qoder)
# CILIX_CODER_DIR=~/partes/Le-fil    # proyecto por defecto (vacío = auto)
CILIX_CODER_ROOTS=~/partes:~/Documents:~/Downloads/cilix
CILIX_CODER_MODE=accept-edits        # plan = solo analiza | accept-edits = edita
# CILIX_CODER_MODEL=                 # modelo del agente (vacío = el suyo)
CILIX_CODER_SANDBOX=true             # comandos aislados dentro del proyecto
# CILIX_CODER_AUTO=true sólo si aceptas que el agente ejecute comandos sin
# preguntar (siempre dentro del sandbox del CLI).
CILIX_CODER_AUTO=false
CILIX_CODER_TIMEOUT=600
CILIX_CODER_MAX_TURNS=30
CILIX_CODER_VOICE=false              # leer el resumen en voz alta
