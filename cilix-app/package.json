{
  "name": "cilix-assistant",
  "version": "2.0.0",
  "description": "Cilix — Asistente de escritorio VTuber con Cerebro Dual local (Ollama). 100% offline.",
  "main": "electron/main.js",
  "author": "Cilix Team",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "backend": "python3 backend/main.py",
    "build-linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "dependencies": {},
  "build": {
    "appId": "com.cilix.assistant",
    "productName": "Cilix",
    "directories": { "output": "dist" },
    "files": [
      "electron/**/*",
      "frontend/**/*",
      "static/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      { "from": "backend", "to": "backend", "filter": ["**/*"] },
      { "from": "models", "to": "models", "filter": ["**/*"] },
      { "from": "config", "to": "config", "filter": ["**/*"] }
    ],
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Utility",
      "synopsis": "Asistente de escritorio local con avatar VTuber"
    }
  }
}
