{
  "name": "cilix-core",
  "version": "1.0.0",
  "description": "Asistente de escritorio local con VTuber femenino - 100% offline",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "install-python-deps": "pip install -r requirements.txt",
    "setup": "npm install && npm run install-python-deps"
  },
  "keywords": [
    "vtuber",
    "ai",
    "local",
    "assistant",
    "electron",
    "python",
    "ollama",
    "piper-tts"
  ],
  "author": "Cilix Team",
  "license": "MIT",
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^25.0.0"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "build": {
    "appId": "com.cilix.assistant",
    "productName": "Cilix Assistant",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!**/node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
      "!**/node_modules/*.d.ts",
      "!**/*.map"
    ],
    "linux": {
      "target": "AppImage",
      "category": "Utility",
      "icon": "assets/icons/icon.png"
    }
  }
}